# Server-only values. Never use a REACT_APP_ prefix here.
APP_SITE_URL=http://localhost:3001
APP_ALLOWED_ORIGINS=http://localhost:3001
# Optional exact origins for property-save only.
APP_PROPERTY_SAVE_EXTRA_ORIGINS=
# Optional current key replacements; otherwise local platform defaults are used.
APP_SUPABASE_PUBLISHABLE_KEY=
APP_SUPABASE_SECRET_KEY=

# Private S3/CloudFront photo lifecycle. Never expose these in React variables.
PHOTO_AWS_REGION=
PHOTO_S3_BUCKET=
PHOTO_AWS_ACCESS_KEY_ID=
PHOTO_AWS_SECRET_ACCESS_KEY=
# Optional only for temporary AWS credentials; refresh before expiry.
PHOTO_AWS_SESSION_TOKEN=
# Independent random secret, >=32 characters, used only by the scheduled cleanup caller.
PHOTO_SCHEDULER_SECRET=

# Public inquiries: independent random HMAC secret (>=32 characters).
APP_RATE_LIMIT_HASH_SECRET=
# Optional: only after proven ingress overwrite/no bypass; unset uses shared limit.
APP_INQUIRY_TRUSTED_IP_HEADER=
