# Browser-visible configuration; never place private secrets here.
PORT=3001
REACT_APP_API_URL=http://localhost:5000/api

# Keep express until the remaining writes/Edge flows reach parity. Rebuild on change.
REACT_APP_BACKEND=express
# Public configuration for isolated Supabase development/staging only:
REACT_APP_SUPABASE_URL=http://127.0.0.1:54321
REACT_APP_SUPABASE_PUBLISHABLE_KEY=
REACT_APP_IMAGE_BASE_URL=
